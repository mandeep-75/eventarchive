# Supabase
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# The anon key is safe to ship in the browser: every table and storage object is
# protected by row level security in supabase/schema.sql. Never put the
# service_role key in here — that one bypasses RLS and would hand every visitor
# full access to the database.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
